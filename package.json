{
  "name": "mailmind-rag",
  "version": "0.1.0",
  "description": "Email triage and PDF Q&A pipeline: intent classification, invoice field extraction, cited answers, and an eval harness.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\")",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "index": "tsx --env-file=.env scripts/index-kb.ts",
    "ask": "tsx --env-file=.env scripts/ask.ts",
    "pipeline": "tsx --env-file=.env scripts/run-pipeline.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1"
  }
}
