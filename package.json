{
  "name": "mailmind-rag",
  "version": "0.1.0",
  "description": "Email triage and PDF Q&A pipeline: intent classification, invoice field extraction, cited answers, and an eval harness.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\")"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
